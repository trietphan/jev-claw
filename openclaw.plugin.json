{
  "id": "jev-claw",
  "name": "Jev Claw",
  "description": "Typed model-routing decisions and opt-in automatic delegation guidance from TypeSafe Jev",
  "categories": [
    "tools"
  ],
  "contracts": {
    "tools": [
      "jev_route"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "autoRoute": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "mode": { "type": "string", "enum": ["guidance", "enforce"], "default": "guidance" },
          "timeoutMs": { "type": "integer", "minimum": 250, "maximum": 10000, "default": 2500 },
          "cacheTtlMs": { "type": "integer", "minimum": 1000, "maximum": 600000, "default": 120000 },
          "minConfidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.65 },
          "fallbackRoute": {
            "type": "string",
            "enum": ["cheap", "main", "architect", "debugger", "reviewer", "claude-builder", "claude-critic", "frontier"],
            "default": "main"
          }
        }
      }
    }
  }
}
